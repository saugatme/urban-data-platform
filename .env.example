# Copy this file to .env only when these local settings are needed.
# Do not commit .env: it may contain machine-specific paths.

# Required only if your Windows Spark installation needs Hadoop helper binaries.
# HADOOP_HOME=C:\path\to\hadoop

# Optional: make PySpark use the project's virtual-environment interpreter.
# PYSPARK_PYTHON=.venv\Scripts\python.exe
# PYSPARK_DRIVER_PYTHON=.venv\Scripts\python.exe
